{
  "version": 2,
  "buildCommand": "cd core && npm run build",
  "outputDirectory": "core/.next",
  "installCommand": "cd core && npm install --force",
  "env": {
    "MONGODB_URI": "@mongodb_uri",
    "NEXTAUTH_SECRET": "@nextauth_secret", 
    "NEXTAUTH_URL": "@nextauth_url",
    "NODE_ENV": "production"
  },
  "functions": {
    "core/app/api/**/route.ts": {
      "maxDuration": 30
    }
  }
}