# Environment Configuration for HomeLee Core
# Copy this file to .env.local and fill in your values

# MongoDB Atlas Connection (Required for both local and cloud)
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/homlee?retryWrites=true&w=majority

# Environment Type (auto-detected, but can override)
# NODE_ENV=development
# NODE_ENV=production

# ZKTeco Backend URL (for local development only)
# In cloud deployment, this should not be set
ZKTECO_BACKEND_URL=http://localhost:3001

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Override cloud detection
# FORCE_CLOUD_ENVIRONMENT=false
